# What a rushed Dockerfile looks like: floating base tag, runs as root. The policy stops it before anything is built.
FROM python:latest
ARG APP_VERSION=dev
ARG BUG=""
ARG REQS=requirements.txt
ENV APP_VERSION=${APP_VERSION} BUG=${BUG}
WORKDIR /app
COPY ${REQS} /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt
COPY app.py .
CMD ["python", "app.py"]
